# target to preprocess a source file
tests/test_world.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\pe_tests.dir\build.make CMakeFiles/pe_tests.dir/tests/test_world.cpp.i
.PHONY : tests/test_world.cpp.i

tests/test_world.s: tests/test_world.cpp.s
.PHONY : tests/test_world.s

# target to generate assembly for a file
tests/test_world.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\pe_tests.dir\build.make CMakeFiles/pe_tests.dir/tests/test_world.cpp.s
.PHONY : tests/test_world.cpp.s

